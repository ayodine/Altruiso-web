{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/pitch",
        "destination": "/pitch/index.html"
      },
      {
        "source": "/pitch/**",
        "destination": "/pitch/index.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
